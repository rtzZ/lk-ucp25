{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--browser", "chromium"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["/Users/aleksandr/.local/bin/github-mcp-server", "stdio"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:/Users/aleksandr/.config/opencode/github-token}"
      }
    }
  }
}
