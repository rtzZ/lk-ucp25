# Шаблон .env: `cp .env.example .env` и заполнить (прод — см. VPS.md).
# ВАЖНО: TELEGRAM_BOT_TOKEN и POSTGRES_PASSWORD — секреты,
# в репозиторий попадает только этот пример.

# Backend
# DATABASE_URL в проде НЕ задавать: docker compose соберёт адрес Postgres
# из POSTGRES_* ниже. Заданное значение перебивает его — SQLite внутри
# контейнера не работает (нет aiosqlite) и терялся бы при пересборке.
# Локальная разработка без Docker:
# DATABASE_URL=sqlite+aiosqlite:///./lk-dev.db
YANDEX_SCHEDULE_URL=
YANDEX_GRADES_URL=
# Синхронизация с таблицами: "*:00" — каждый час в :00 (по SYNC_TIMEZONE);
# конкретные часы — "09:30,11:00"
SYNC_TIMES=*:00
SYNC_TIMEZONE=Europe/Moscow
# Не применять синк, если записей стало меньше этой доли от прежнего
# (сломался лист/формат). Ожидаемое сокращение: python -m app.admin sync --force
# SYNC_MIN_RATIO=0.5
# LK_GROUP=УЦП-25
EXPIRE_INTERVAL_HOURS=1
# SEED_DEMO=1 — только для разработки! В проде НЕ ставить (зальёт демо-студентов).
# SKIP_DB_INIT=1
FRONTEND_URL=http://localhost:5173
# Прод: FRONTEND_URL=https://your-domain.com
LOG_LEVEL=INFO
# CHROMIUM_NO_SANDBOX=1 — только в Docker (ставит сам compose).

# PostgreSQL (docker compose)
POSTGRES_USER=lk
# Прод: длинный случайный пароль, напр. `openssl rand -hex 24`
POSTGRES_PASSWORD=lk
POSTGRES_DB=lk
# POSTGRES_PORT=5432

# Вход: временный пароль от Telegram-бота (без бота войти нельзя).
# Токен — у @BotFather (отозвать при компрометации). Бот должен быть
# участником группы курса TELEGRAM_GROUP_ID (id вида -100...), иначе
# getChatMember не работает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# SESSION_TTL_DAYS=30
# AUTH_DEV_MODE=1 — только локально: пароль в ответе API вместо Telegram.
# При заданном TELEGRAM_BOT_TOKEN игнорируется.

# Frontend (только сборка/дев)
VITE_API_URL=http://localhost:8001
# Прод-сборка: VITE_API_URL=/api (nginx проксирует /api/ на backend)
