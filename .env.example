# Копия в .env для локальной разработки. В проде задавать через окружение.
# ВАЖНО: TELEGRAM_BOT_TOKEN и POSTGRES_PASSWORD — секреты,
# в репозиторий попадает только этот пример.

# Backend
DATABASE_URL=sqlite+aiosqlite:///./lk-dev.db
# Прод (docker compose): postgresql+asyncpg://lk:СЛОЖНЫЙ_ПАРОЛЬ@db:5432/lk
# (можно не задавать — compose соберёт из POSTGRES_* ниже)
YANDEX_SCHEDULE_URL=
YANDEX_GRADES_URL=
# Синхронизация дважды в сутки по Москве (формат "HH:MM,HH:MM")
SYNC_TIMES=09:30,11:00
SYNC_TIMEZONE=Europe/Moscow
EXPIRE_INTERVAL_HOURS=1
# SEED_DEMO=1 — только для разработки! В проде НЕ ставить (зальёт демо-студентов).
# SKIP_DB_INIT=1
FRONTEND_URL=http://localhost:5173
# Прод: FRONTEND_URL=https://your-domain.com
LOG_LEVEL=INFO
# CHROMIUM_NO_SANDBOX=1 — только в Docker (ставит сам compose).

# PostgreSQL (docker compose)
POSTGRES_USER=lk
POSTGRES_PASSWORD=lk
POSTGRES_DB=lk
# POSTGRES_PORT=5432

# Telegram-вход (получить у @BotFather; токен отозвать при компрометации)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=

# Frontend (только сборка/дев)
VITE_API_URL=http://localhost:8001
# Прод-сборка: VITE_API_URL=/api (nginx проксирует /api/ на backend)
